[Unit]
PartOf=arkive-ap.target
Description=Arkive access point DHCP server
Requires=arkive-ap-interface.service
After=arkive-ap-interface.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/dnsmasq.d/arkive.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
